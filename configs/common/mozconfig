ac_add_options --with-app-name=${binName}
export MOZ_USER_DIR="${name}"
export MOZ_APP_BASENAME=${binName}
export MOZ_DISTRIBUTION_ID=${appId}

# Uncomment if builds are too resource hungry
# mk_add_options MOZ_MAKE_FLAGS="-j4"
# ac_add_options --enable-linker=gold

# Misc
export MOZ_STUB_INSTALLER=1
export MOZ_INCLUDE_SOURCE_INFO=1
# Change the below repository to your GitHub repository.
export MOZ_SOURCE_REPO=https://github.com/example/example
export MOZ_SOURCE_CHANGESET=${changeset}

# Bootstrap
ac_add_options --enable-bootstrap

# API keys. These live in configs/keys, which git ignores, so they never end up
# in the repository. Builds without a key still work; that feature just stays
# off. Google Safe Browsing powers "Block dangerous and deceptive content".
_pf_keys="$topsrcdir/../configs/keys"
if [ -f "$_pf_keys/google-safebrowsing.key" ]; then
  _pf_keys_dir="$(cd "$_pf_keys" && (pwd -W 2>/dev/null || pwd))"
  ac_add_options --with-google-safebrowsing-api-keyfile="$_pf_keys_dir/google-safebrowsing.key"
fi
