ac_add_options --target=x86_64-pc-windows-msvc
ac_add_options --enable-js-shell 
ac_add_options --enable-rust-simd 
ac_add_options --disable-maintenance-service

# Disable telemetry and tracking
mk_add_options MOZ_TELEMETRY_REPORTING=
mk_add_options MOZ_DATA_REPORTING=

# No Mozilla Maintenance Service. Firefox's installer sets up a Windows service
# with that name, so installing Pufferfish could replace or conflict with
# Firefox's copy, and the service only runs updaters signed by Mozilla, so it
# couldn't install Pufferfish updates anyway. Without it, updating a copy
# installed in Program Files asks once for permission (a Windows UAC prompt).
