## Pufferfish: the Pufferfish page in Settings.

pane-pufferfish-title = { -brand-short-name }

pufferfish-pane-header =
    .heading = { -brand-short-name }

## Puff Dock section on the Pufferfish page.

puff-dock-group-header =
    .label = Puff Dock
    .description = Thumbnails of your tabs that slide out when you move the mouse to the edge of the page.

puff-dock-enabled =
    .label = Show the Puff Dock

puff-dock-position =
    .label = Where the dock opens

puff-dock-position-top =
    .label = Under the toolbar

puff-dock-position-bottom =
    .label = At the bottom of the window

puff-dock-mute-button =
    .label = Show a mute button on thumbnails
    .description = It stays visible on tabs that are playing sound.

puff-dock-close-button =
    .label = Show a close button on thumbnails

puff-dock-magnify =
    .label = Enlarge thumbnails near the mouse

puff-dock-help =
    .label = Learn more about the Puff Dock

puff-dock-reduce-motion =
    .label = Reduce motion
    .description = Opens the dock and the full-screen view without sliding or zooming. This is always on when animation effects are turned off in Windows.
